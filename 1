-- TOGGLE FUNCTION
local function createToggle(name, posY)
	local holder = Instance.new("Frame")
	holder.Parent = frame
	holder.Size = UDim2.new(0.85,0,0,55)
	holder.Position = UDim2.new(0.075,0,posY,0)
	holder.BackgroundTransparency = 1
	holder.ZIndex = 3

	local text = Instance.new("TextLabel")
	text.Parent = holder
	text.Text = name
	text.Size = UDim2.new(0.6,0,1,0)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.new(1,1,1)
	text.TextSize = 18
	text.Font = Enum.Font.GothamBold
	text.ZIndex = 3

	local toggle = Instance.new("Frame")
	toggle.Parent = holder
	toggle.Size = UDim2.new(0,70,0,32)
	toggle.Position = UDim2.new(1,-80,0.5,-16)
	toggle.BackgroundColor3 = Color3.fromRGB(35,35,35)
	toggle.ZIndex = 3

	Instance.new("UICorner", toggle).CornerRadius = UDim.new(1,0)

	local circle = Instance.new("Frame")
	circle.Parent = toggle
	circle.Size = UDim2.new(0,26,0,26)
	circle.Position = UDim2.new(0,3,0.5,-13)
	circle.BackgroundColor3 = Color3.new(1,1,1)
	circle.ZIndex = 3

	Instance.new("UICorner", circle).CornerRadius = UDim.new(1,0)

	local state = false

	local function update()
		if state then
			TweenService:Create(circle, TweenInfo.new(0.2), {
				Position = UDim2.new(1,-29,0.5,-13)
			}):Play()

			TweenService:Create(toggle, TweenInfo.new(0.2), {
				BackgroundColor3 = Color3.fromRGB(180,0,255)
			}):Play()
		else
			TweenService:Create(circle, TweenInfo.new(0.2), {
				Position = UDim2.new(0,3,0.5,-13)
			}):Play()

			TweenService:Create(toggle, TweenInfo.new(0.2), {
				BackgroundColor3 = Color3.fromRGB(35,35,35)
			}):Play()
		end
	end

	toggle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

			state = not state
			update()
		end
	end)
end

